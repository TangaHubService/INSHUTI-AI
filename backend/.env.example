# Postgres connection string (production / CI). For local dev without a
# Postgres instance, set this to a sqlite file path instead — resolved
# relative to prisma/, so this creates prisma/dev.db:
# DATABASE_URL="file:./dev.db"
# and use the `dev:db:*` npm scripts, which target prisma/schema.sqlite.prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/inshuti?schema=public"

# Long random secrets — generate with `openssl rand -hex 32`. Never reuse
# between environments.
JWT_SECRET=""
SESSION_COOKIE_SECRET=""

OPENAI_API_KEY=""

# Frontend origin, used for CORS. Add additional origins via CORS_ALLOWED_ORIGINS
# (comma-separated) if the frontend is served from multiple domains, e.g.:
#   CORS_ALLOWED_ORIGINS="https://inshuti-ai.netlify.app,https://inshuti.org"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

PORT=4000
NODE_ENV="development"

# Super admin seeded by `npm run db:migrate:deploy && npx tsx prisma/seed.ts`
# (or `npm run dev:db:seed` locally). Email defaults to
# sibomanadamascene1999@gmail.com if SEED_SUPER_ADMIN_EMAIL is unset — the
# password has NO default and must be set here for non-interactive/production
# seeding; local interactive runs fall back to a masked terminal prompt.
SEED_SUPER_ADMIN_EMAIL="sibomanadamascene1999@gmail.com"
SEED_SUPER_ADMIN_PASSWORD=""
SEED_SUPER_ADMIN_NAME="Super Admin"

# Demo accounts (teen/parent/nurse/gov@example.com) seeded locally with this
# password by default if unset ("test1234"). In production there is no
# default — set this explicitly if you actually want those demo accounts
# on a production database; otherwise leave it unset and seeding skips them.
SEED_DEMO_USERS_PASSWORD=""
# Development demos only. Never enable in production; licensed clinicians
# must approve content through the knowledge-base workflow.
SEED_ALLOW_UNREVIEWED_CONTENT="false"
SEED_ALLOW_UNVERIFIED_FACILITIES="false"

# Consultation message encryption key — at least 32 characters. Required in
# production; falls back to a dev default if unset in development.
MESSAGE_ENCRYPTION_KEY="your-32-char-min-encryption-key-here"

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# SMS provider — "stub" (default, logs to console) or "twilio"
SMS_PROVIDER="stub"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+250xxxxxx"

# Browser push notifications. Generate once with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@inshuti.rw"

# Anonymous AI conversations without a professional consultation are deleted
# after this period. Confirm the value in the approved retention policy.
ANONYMOUS_RETENTION_DAYS=30
GOV_AGGREGATE_MIN_COUNT=5
